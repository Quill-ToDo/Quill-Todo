{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug next.js client",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run debug",
            "cwd": "${workspaceFolder}/quill-fe"
        },
        {
            "name": "Debug Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}/quill-fe"
        },
        {
            "name": "Debug Firefox",
            "type": "firefox",
            "request": "launch",
            "url": "http://localhost:3001",
            "pathMappings": [
                {
                    "url": "webpack://_n_e/src/app",
                    "path": "${workspaceFolder}/quill-fe/src/app"
                }
            ]
        },
        {
            "name": "Debug server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\manage.py",
            "args": [
                "runserver"
            ],
            "django": true,
            "justMyCode": true
        }
    ]
}